		<ee:transform doc:name="prepare-order-partner-assignments" doc:id="f865d887-c207-4ae4-bb9a-477945c3bef8" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
var packagedOrders=vars.orders filter((item)->item.Order_Status__c=="packaged" and item.IsCancelled__c=="false") default []
var activePartners=vars.dps filter((item)->item.IsActive__c=="true") default []
---
if (sizeOf(packagedOrders) == 0 or sizeOf(activePartners) == 0)
    []
else
    packagedOrders map ((item, index) ->
        {
            orderId: item.Order_Id__c,
            deliveryDate: item.Delivery_Date__c,
            dpname: activePartners[(index mod sizeOf(activePartners))].Name__c,
            partnerId: activePartners[(index mod sizeOf(activePartners))].Partner_Id__c
        }
    )]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="assignedOrders" ><![CDATA[%dw 2.0
output application/json
var packagedOrders=vars.orders filter((item)->item.Order_Status__c=="packaged" and item.IsCancelled__c=="false") default []
var activePartners=vars.dps filter((item)->item.IsActive__c=="true") default []
---
if (sizeOf(packagedOrders) == 0 or sizeOf(activePartners) == 0)
    []
else
    packagedOrders map ((item, index) ->
        {
            orderId: item.Order_Id__c,
            deliveryDate: item.Delivery_Date__c,
            dpname: activePartners[(index mod sizeOf(activePartners))].Name__c,
            partnerId: activePartners[(index mod sizeOf(activePartners))].Partner_Id__c
        }
    )]]></ee:set-variable>
			</ee:variables>
